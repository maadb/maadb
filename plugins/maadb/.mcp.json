{
  "mcpServers": {
    "maadb": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "--package=@maadb/core@0.23.0",
        "maad",
        "serve",
        "--project",
        "${user_config.project_dir}",
        "--role",
        "${user_config.role}"
      ],
      "env": {
        "MAAD_BOOT_REINDEX": "1"
      }
    }
  }
}
